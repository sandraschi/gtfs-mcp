{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Gtfs MCP",
    "version": "0.1.0",
    "identifier": "com.sandraschi.gtfs-mcp",
    "build": {
        "frontendDist": "../web_sota/dist",
        "beforeDevCommand": "npm --prefix ../web_sota run dev",
        "beforeBuildCommand": "npm --prefix ../web_sota run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Gtfs MCP",
                "width": 1280,
                "height": 860,
                "minWidth": 700,
                "minHeight": 500,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png", "icons/icon.ico"],
        "resources": [
            "resources/gtfs-mcp-backend.exe",
            "resources/.env.example"],
        "windows": {
            "webviewInstallMode": {
                "type": "skip"
            },
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    },
    "plugins": {}
}

