# GTFS MCP server configuration template.
# Copy to .env and adjust values. NEVER commit the real .env.

# --- Server ---
# GTFS_MCP_HOST=127.0.0.1
# GTFS_MCP_PORT=10913
# GTFS_MCP_LOG_LEVEL=INFO

# --- Feed management ---
# Default GTFS feed to load on startup (zip URL). Vienna (Wiener Linien) is the
# fleet default; override to any agency feed.
GTFS_MCP_DEFAULT_FEED_URL=https://www.wienerlinien.at/ogd_realtime/doku/ogd/gtfs/gtfs.zip
GTFS_MCP_UPDATE_INTERVAL=86400

# --- Feed discovery (optional API keys) ---
# GTFS_MCP_DISCOVERY__TRANSITFEEDS_API_KEY=
# GTFS_MCP_DISCOVERY__MTA_API_KEY=

# --- External services (optional) ---
# GTFS_MCP_MAPBOX_ACCESS_TOKEN=
# GTFS_MCP_GOOGLE_MAPS_API_KEY=

# --- publictransport-mcp export (cross-repo file drop) ---
# Repo root of the publictransport-mcp checkout that export_feed writes
# scripts/gtfs_data/cities/<feed_id>/ into. Empty = a `publictransport-mcp`
# sibling of this repo carrying scripts/gtfs_data; otherwise the export
# refuses with guidance instead of writing nowhere.
# GTFS_MCP_PUBLICtransport_ROOT=D:/Dev/repos/publictransport-mcp
# (GTFS_MCP_MYWIENERLINIEN_ROOT still accepted as a deprecated alias.)

# --- Transport (MCP over HTTP for webapp / Tauri) ---
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=10913
